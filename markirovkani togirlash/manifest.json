{
  "manifest_version": 3,
  "name": "Markirovkali chek tayyorlash",
  "description": "Inventarizatsiyadan markirovkali tovarlarni olib, Подбор kodlari orqali bitta hujjat tayyorlaydi, natsenka va ichki qoldiqni hisoblaydi.",
  "version": "1.1.9",
  "key": "",
  "permissions": [
    "storage",
    "debugger",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://tas-1cbuxapp-01/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://tas-1cbuxapp-01/*"
      ],
      "js": [
        "receipt-math.js",
        "stock-ledger.js",
        "receipt-pair.js",
        "markup-driver.js",
        "state-migration.js",
        "work-clock.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Markirovkali chek panelini yon tomonda ochish"
  }
}
