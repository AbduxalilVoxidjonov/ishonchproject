{
  "manifest_version": 3,
  "name": "MXIK Qidiruv (soliq.uz)",
  "version": "0.4.6",
  "key": "",
  "description": "my.soliq.uz markirovka va tasnif.soliq.uz MXIK bo'yicha kodlarni ommaviy tekshirish.",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://my.soliq.uz/*",
    "https://tasnif.soliq.uz/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://tas-1cbuxapp-01/*"
    ],
    "ids": [
      "iimlgpfdhffcigknhggakccmgbljiloj"
    ]
  },
  "action": {
    "default_title": "MXIK Qidiruv (yon panel)"
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.soliq.uz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://my.soliq.uz/*"
      ],
      "js": [
        "page-active.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
